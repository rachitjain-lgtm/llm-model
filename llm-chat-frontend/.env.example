# Public Google OAuth client id used by the login screen.
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# OpenRouter key used for free/open model requests.
# For local development, copy this file to `.env.local` and paste your real key there.
VITE_OPENROUTER_API_KEY="your-openrouter-api-key"

# Optional app label sent with OpenRouter requests.
VITE_APP_NAME="AI Studio"

# Optional override if you ever proxy or change the provider endpoint.
VITE_OPENROUTER_API_URL="https://openrouter.ai/api/v1/chat/completions"
